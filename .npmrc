# Exact versions only; lockfile is the source of truth.
save-exact=true
engine-strict=true
fund=false
# Never run dependency lifecycle scripts (preinstall/install/postinstall). No current dependency
# needs one (checked in the M0.5 audit); this blocks a compromised future version from running code
# during npm ci. `npm run <script>` for this project still works.
ignore-scripts=true
