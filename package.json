{
  "name": "amos-ai",
  "version": "0.0.0",
  "private": true,
  "description": "AMOS AI — personal local-first AI workstation agent",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "bin": {
    "amos": "dist/cli/main.js"
  },
  "scripts": {
    "build": "node scripts/clean.ts dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret-scan": "node scripts/secret-scan.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run secret-scan && npm run build",
    "amos": "node src/cli/main.ts",
    "doctor": "node src/cli/main.ts doctor",
    "probe": "node scripts/probe-connectivity.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
